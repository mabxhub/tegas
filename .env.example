# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web application)
# Authorized redirect URI: http://localhost:3000/auth/google/callback
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
# Comma separated exact teacher emails
ALLOWED_EMAILS=
# Development only. Disabled automatically in production.
DEMO_MODE=false
PORT=3000
# SaaS mode: app data lives in each school's Google Drive.
# Requires persistent DATA_DIR for account registry, encrypted tokens and sessions.
STORAGE_MODE=local
# Set STORAGE_MODE=drive to activate. OAuth scope includes drive.file on registration.
# Generate 32 random bytes and encode as base64; never commit the actual key.
TOKEN_ENCRYPTION_KEY=
